@{
    // Sets the title for this page.
    // This value can be accessed by the shared layout using ViewData["Title"].
    ViewData["Title"] = "Farming App";
}


<!-- Main container for the home page. -->
<div class="home-page">


    <!-- Hero section that introduces the application
         and displays its current online status. -->
    <section class="home-hero">

        <!-- Main heading of the home page. -->
        <h1>
            Smart-X Hydroponic farming
        </h1>


        <!-- Brief description explaining the purpose
             of the telemetry system. -->
        <p>
            This app a is centralised telemetry gateway for
            monitoring and managing the Hydroponic farm created by Smart-X.
        </p>

    </section>



    <!-- Contains the different modules that form part
         of the system architecture. -->
    <section class="architecture-container">


        <!-- Displays the heading and description
             for the system architecture section. -->
        <div class="section-title">

            <div>

                <!-- Small heading used to identify
                     the system architecture section. -->
                <p class="eyebrow">
                    SYSTEM ARCHITECTURE
                </p>

            </div>

        </div>



        <!-- Grid container used to display the
             different Smart-X module cards. -->
        <div class="pillar-grid">


            <!-- PART 1: SENSOR DATA INGESTION MODULE -->
            <!-- Creates a clickable card for the currently active module.
                 ASP.NET Core Tag Helpers navigate the user to the Index
                 action of the TelemetryController. -->
            <a asp-controller="Telemetry"
               asp-action="Index"
               class="pillar-card active-card">

                
                <!-- Displays the name of the first module. -->
                <h3>
                    Sensor Data Ingestion
                    & Telemetry
                </h3>


                <!-- Describes the functionality provided
                     by the telemetry module. -->
                <p class="card-description">

                    Register IoT devices,
                    ingest strongly typed telemetry,
                    upload hardware files and monitor
                    live sensor events.

                </p>


                <!-- Provides a visual call-to-action showing
                     that the user can open this module. -->
                <div class="card-action">

                    Launch Gateway

                    <!-- Arrow indicating navigation to another page. -->
                    <span>
                        →
                    </span>

                </div>

            </a>



            <!-- PART 2: REAL-TIME COMMAND MODULE -->
            <!-- Displays the second Smart-X module.
                 This module is currently locked and is therefore
                 displayed as a div instead of a clickable link. -->
            <div class="pillar-card locked-card">

                <!-- Displays the name of the second module. -->
                <h3>
                    Real-Time Command
                    Stream & History
                </h3>


                <!-- Describes the functionality that will
                     eventually be provided by this module. -->
                <p class="card-description">

                    Process real-time command
                    queues, issue device instructions
                    and manage command history.

                </p>


                <!-- Indicates that the module cannot
                     currently be accessed by the user. -->
                <div class="card-action disabled-action">

                    Currently unavailable

                </div>

            </div>



            <!-- FINAL POE: NETWORK TOPOLOGY MODULE -->
            <!-- Displays the final Smart-X module.
                 This module remains locked until the final POE stage. -->
            <div class="pillar-card locked-card">

                <!-- Displays the name of the final module. -->
                <h3>
                    Network Topology
                    & Mesh Routing
                </h3>


                <!-- Describes the planned network visualisation
                     and telemetry routing functionality. -->
                <p class="card-description">

                    Visualise the Smart-X mesh
                    network and calculate efficient
                    telemetry routing paths.

                </p>


                <!-- Indicates that the module cannot
                     currently be accessed by the user. -->
                <div class="card-action disabled-action">

                    Currently unavailable

                </div>

            </div>


        </div>

    </section>

</div>